    alt: 'R&R Seamless Gutters project photo'
  },
  {
    src: 'https://img1.wsimg.com/isteam/ip/c00dfd75-74be-43d7-9290-15591ce22b2b/IMG_4206.JPG/:/rs=w:1240,m',
