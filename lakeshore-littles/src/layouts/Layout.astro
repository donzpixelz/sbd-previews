---
const { title = 'Lakeshore Littles Play Café' } = Astro.props;
const base=import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><meta name="description" content="Unofficial preservation-first migration demonstration of the public Lakeshore Littles Play Café website."/><title>{title}</title><link rel="icon" href="data:,"/><style is:global>
:root{font-family:Arial,Helvetica,sans-serif;color:#272727;background:#fff;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:inherit}a:focus-visible{outline:3px solid #2255bb;outline-offset:3px}.demo{font:600 11px/1.4 Arial,sans-serif;padding:9px 18px;text-align:center;background:#222;color:#fff;letter-spacing:.06em}.wrap{max-width:1080px;margin:auto;padding:0 28px}.nav{min-height:90px;display:flex;align-items:center;justify-content:space-between;gap:24px}.logo{font-size:20px;letter-spacing:.02em;font-weight:700;text-decoration:none}.links{display:flex;align-items:center;flex-wrap:wrap;gap:25px}.links a{text-decoration:none;font-size:14px}.links a:hover{text-decoration:underline}.section{padding:80px 0}.section h1,.section h2{font-weight:500;line-height:1.2;margin:0 0 25px}.section h2{font-size:35px}p{line-height:1.8}.button{display:inline-block;padding:14px 27px;background:#242424;color:white;text-decoration:none;font-size:14px;transition:opacity .2s}.button:hover{opacity:.85}.footer{background:#f6f6f6;padding:46px 0;text-align:center;font-size:13px;line-height:1.9}.footer strong{font-size:17px}.footer a{display:inline-block}.footer .copy{font-size:12px}.footer address{font-style:normal}img{max-width:100%;height:auto} @media(max-width:700px){.wrap{padding:0 20px}.nav{padding:23px 0;display:block;min-height:0}.links{margin-top:20px;gap:18px}.section{padding:48px 0}.section h2{font-size:30px}}
</style></head><body><div class="demo">INDEPENDENT SALES DEMONSTRATION — NOT THE OFFICIAL BUSINESS SITE · NO ORDERS OR BOOKINGS</div><header><div class="wrap nav"><a class="logo" href={base}>Lakeshore Littles Play Café</a><nav class="links" aria-label="Main navigation"><a href={base}>Home</a><a href={base+'menus/'}>Café Menu</a><a href={base+'event-details/grand-opening/'}>Grand Opening</a></nav></div></header><slot/><footer class="footer"><div class="wrap"><strong>Lakeshore Littles Play Café</strong><address>1125 Washington Ave, Grand Haven, MI 49417<br/><a href="mailto:lakeshorelittlesplaycafe@gmail.com">lakeshorelittlesplaycafe@gmail.com</a><br/><a href="tel:+16168436917">(616) 843-6917</a></address><p class="copy">© 2026 Lakeshore Littles Play Café. All rights reserved.</p><p class="copy">Unofficial demonstration. Payment and booking systems have not been migrated.</p></div></footer></body></html>