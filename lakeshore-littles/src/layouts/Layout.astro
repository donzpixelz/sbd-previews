---
const { title = 'Lakeshore Littles Play Café' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
  ['Home', base],
  ['About Us', base + 'about-lakeshore-littles/'],
  ["FAQ's", base + 'frequently-asked-questions/'],
  ['Events', base + 'event-list/'],
  ['Menus', base + 'menus/'],
  ['Plans & Pricing', base + 'pricing-plans/plans-pricing/'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="description" content="Lakeshore Littles Play Café migration preview." />
  <title>{title}</title>
  <link rel="icon" href="data:," />
  <style is:global>
    :root{
      --blue:#8fb8d6;
      --footer:#edf5fb;
      --mist:#eef6fb;
      --stone:#efefea;
      --ink:#171717;
      --muted:#66645c;
      --line:#d9d8d1;
      font-family:"Avenir Next",Avenir,"Helvetica Neue",Arial,sans-serif;
      color:var(--ink);
      background:#fff;
      font-synthesis:none;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:#fff;font-weight:400;overflow-x:hidden}
    a{color:inherit}
    img{max-width:100%;display:block}
    button,input{font:inherit}
    .site-header{background:var(--blue);height:158px}
    .nav-shell{height:100%;max-width:1340px;margin:0 auto;display:grid;grid-template-columns:190px 1fr 190px;align-items:center;padding:0 44px}
    .brand{display:inline-flex;align-items:center;width:112px;height:96px;text-decoration:none}
    .brand img{width:112px;height:90px;object-fit:contain}
    .nav-links{display:flex;justify-content:center;align-items:center;gap:52px}
    .nav-links a{font-size:17px;text-decoration:none;white-space:nowrap;padding:8px 0;border-bottom:1px solid transparent}
    .nav-links a:hover,.nav-links a.active{border-bottom-color:currentColor}
    .mobile-menu{display:none}
    main{min-height:300px}
    .page-width{width:min(1320px,calc(100% - 72px));margin:0 auto}
    .footer{background:var(--footer);min-height:510px;padding:84px 0 58px}
    .footer-inner{width:min(1320px,calc(100% - 72px));margin:0 auto;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:end;min-height:350px}
    .footer-logo{width:112px;height:112px;object-fit:contain;margin-bottom:24px}
    .footer-name{font-size:23px;margin:0 0 26px}
    .footer address{font-style:normal;font-size:14px;line-height:1.6}
    .footer address a{text-decoration:none}
    .copyright{font-size:12px;margin-top:62px;color:#555}
    .socials{display:flex;gap:16px;justify-content:center;align-items:center;padding-bottom:60px}
    .socials a{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:13px;font-weight:700;text-decoration:none}
    .socials .fb{background:#1877f2}.socials .ig{background:#ff2b7a}.socials .tt{background:#000}
    .preview-note{text-align:right;align-self:end;padding-bottom:60px;font-size:11px;color:#6f7478}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-width:190px;padding:16px 30px;border-radius:32px;background:var(--blue);color:#fff;text-decoration:none;border:1px solid var(--blue);font-size:14px}
    .btn.ghost{background:transparent;color:#6292b6}
    .inert{cursor:default}
    @media(max-width:900px){
      .site-header{height:104px;min-height:104px}
      .nav-shell{display:flex;height:104px;padding:10px 18px;align-items:center;justify-content:space-between}
      .nav-shell>div:last-child{display:none}
      .brand,.brand img{width:112px;height:84px}
      .nav-links{display:none}
      .mobile-menu{display:block;position:relative}
      .mobile-menu summary{list-style:none;cursor:pointer;width:48px;height:48px;display:grid;place-items:center;border:1px solid rgba(0,0,0,.22);border-radius:10px;background:rgba(255,255,255,.18)}
      .mobile-menu summary::-webkit-details-marker{display:none}
      .hamburger{width:22px;height:16px;display:flex;flex-direction:column;justify-content:space-between}
      .hamburger span{height:2px;width:100%;background:#111;border-radius:2px}
      .mobile-menu[open] summary{background:#fff}
      .mobile-nav{position:absolute;right:0;top:58px;z-index:1000;min-width:230px;background:#fff;border:1px solid #d7d7d2;border-radius:12px;box-shadow:0 12px 28px rgba(0,0,0,.16);overflow:hidden}
      .mobile-nav a{display:block;padding:15px 18px;text-decoration:none;font-size:15px;border-bottom:1px solid #ecebe7}
      .mobile-nav a:last-child{border-bottom:0}
      .mobile-nav a.active{background:var(--mist);font-weight:600}
      .page-width{width:calc(100% - 28px);max-width:760px}
      .footer{padding:50px 0}
      .footer-inner{width:calc(100% - 36px);max-width:760px;grid-template-columns:1fr;gap:34px;min-height:0}
      .socials{justify-content:flex-start;padding:0}
      .copyright{margin-top:34px}
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="nav-shell">
      <a class="brand" href={base} aria-label="Lakeshore Littles Play Café home">
        <img src={base+'assets/original/1cc917_df07512e66bf44ac86e449f73d9409af~mv2.png'} alt="Lakeshore Littles Play Café logo" />
      </a>
      <nav class="nav-links" aria-label="Main navigation">
        {nav.map(([label,href]) => <a class={path===href || (href!==base && path.startsWith(href)) ? 'active' : ''} href={href}>{label}</a>)}
      </nav>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu">
          <span class="hamburger" aria-hidden="true"><span></span><span></span><span></span></span>
        </summary>
        <nav class="mobile-nav" aria-label="Mobile navigation">
          {nav.map(([label,href]) => <a class={path===href || (href!==base && path.startsWith(href)) ? 'active' : ''} href={href}>{label}</a>)}
        </nav>
      </details>
      <div></div>
    </div>
  </header>
  <slot />
  <footer class="footer">
    <div class="footer-inner">
      <div>
        <img class="footer-logo" src={base+'assets/original/1cc917_ce8a3c18a8dc4d6687d47a5683230d08~mv2.png'} alt="Lakeshore Littles Play Café" />
        <p class="footer-name">Lakeshore Littles Play Café</p>
        <address>
          1125 Washington Ave, Grand Haven, MI 49417<br/>
          <a href="mailto:lakeshorelittlesplaycafe@gmail.com">lakeshorelittlesplaycafe@gmail.com</a><br/>
          <a href="tel:+16168436917">(616) 843-6917</a>
        </address>
        <p class="copyright">© 2026 Lakeshore Littles Play Café. All rights reserved.</p>
      </div>
      <div class="socials" aria-label="Social links shown on the original site">
        <a class="fb" href="https://www.facebook.com/profile.php?id=61578449777024" target="_blank" rel="noreferrer" aria-label="Facebook">f</a><a class="ig" href="https://www.instagram.com/lakeshore.littles/" target="_blank" rel="noreferrer" aria-label="Instagram">◎</a><a class="tt" href="https://www.tiktok.com/@lakeshore.littles" target="_blank" rel="noreferrer" aria-label="TikTok">♪</a>
      </div>
    </div>
  </footer>
  <script is:inline>
    const mobileMenu = document.querySelector('.mobile-menu');
    if (mobileMenu) {
      document.addEventListener('click', (event) => {
        if (mobileMenu.open && !mobileMenu.contains(event.target)) {
          mobileMenu.removeAttribute('open');
        }
      });
    }
  </script>
</body>
</html>
