---
import Layout from '../../layouts/Layout.astro';
const base=import.meta.env.BASE_URL;
---
<Layout title="Menus | Lakeshore Littles Play Café">
<main class="menu-page">
  <img src={base+'assets/original/1cc917_70da51c5d9664b5aaeca0931765664de~mv2.png'} alt="Lakeshore Littles Café menu" />
</main>
<style>
  .menu-page{display:flex;justify-content:center;align-items:flex-start;padding:0 20px}
  .menu-page img{width:min(700px,76vw);height:auto}
  @media(max-width:700px){.menu-page img{width:100%}}
</style>
</Layout>
