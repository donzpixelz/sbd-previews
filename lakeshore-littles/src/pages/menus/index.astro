---
import Layout from '../../layouts/Layout.astro';
const base=import.meta.env.BASE_URL;
---
<Layout title="Menus | Lakeshore Littles Play Café"><main class="section menu"><div class="wrap"><h1>Café Menu</h1><p class="empty">There are no items to show here yet</p><img class="menuimage" alt="Updated Menu, as provided on the public Lakeshore Littles Wix menu page" src={base+'menu-image.svg'}/><p class="small">Menu graphic is served from the original Wix site. The menu widget's published empty state is preserved, not repaired, for fidelity.</p></div></main><style>.menu{text-align:center;min-height:60vh}.menu h1{font-size:35px;font-weight:500}.empty{padding:24px;color:#777}.menuimage{display:block;margin:20px auto;width:min(100%,720px);height:auto}.small{font-size:12px;color:#777}</style></Layout>