---
import Layout from '../layouts/Layout.astro';
const base=import.meta.env.BASE_URL;
---
<Layout>
<main>
  <section class="home-hero">
    <img src={base+'assets/original/1cc917_f3baa7fd5e7945fd9c31a317186aecc6~mv2.png'} alt="Lakeshore Littles Play Café interior" />
  </section>

  <section class="intro page-width">
    <h1>Lakeshore Littles Play Café</h1>
    <div class="motto">WHERE FAMILIES SIP &amp; PLAY ☕ WHERE FAMILIES SIP &amp; PLAY ☕ WHERE FAMILIES SIP &amp; PLAY</div>
    <p>Come play, sip, and stay awhile at Lakeshore Littles Play Café—a modern, feel-good space made for laughter, connection, and everyday magic.</p>
    <div class="intro-actions">
      <a class="btn" href="#play-space">Explore Our Space</a>
      <a class="btn ghost" href={base+'menus/'}>Café Menu</a>
    </div>
  </section>

  <section class="play page-width" id="play-space">
    <img src={base+'assets/original/1cc917_6e3e0c8d65ec4f309aa19415aa08a50a~mv2.jpg'} alt="Children playing together" />
    <div class="play-copy">
      <h2>Our Play Space</h2>
      <p>We've created a space where connection just happens—where kids can play, explore, and laugh, and caregivers can slow down, recharge, and enjoy the moment right alongside them.</p>
      <dl>
        <div><dt>Single Child<br/>Play</dt><dd>$10.00</dd></div>
        <div><dt>Punch Cards</dt><dd>$80.00</dd></div>
        <div><dt>Birthday Parties</dt><dd>$300.00</dd></div>
      </dl>
    </div>
  </section>

  <section class="hours">
    <div class="page-width hours-inner">
      <h2>Hours &amp; Location</h2>
      <p>Open Play Hours: Monday–Friday: 9:00 AM – 2:00 PM Saturday–Sunday: Closed for events</p>
      <p>Location: 1125 Washington Ave, Grand Haven, MI 49417</p>
      <a class="btn" href="https://www.google.com/maps/search/?api=1&query=1125+Washington+Ave+Grand+Haven+MI+49417" target="_blank" rel="noreferrer">Get Directions</a>
    </div>
  </section>
</main>
<style>
  .home-hero{width:100%;height:min(57vw,820px);overflow:hidden}
  .home-hero img{width:100%;height:100%;object-fit:cover;object-position:center}
  .intro{padding:82px 0 104px}
  .intro h1{font-size:clamp(48px,5.2vw,78px);line-height:1.05;font-weight:400;margin:0 0 24px}
  .motto{font-size:22px;font-weight:600;letter-spacing:.015em;white-space:nowrap;overflow:hidden;margin-left:calc((100vw - min(1320px,calc(100vw - 72px)))/-2)}
  .intro p{max-width:620px;font-size:17px;line-height:1.6;margin:54px 0 42px}
  .intro-actions{display:flex;gap:34px}
  .play{display:grid;grid-template-columns:1fr 1fr;padding-bottom:82px}
  .play>img{width:100%;height:100%;min-height:610px;object-fit:cover}
  .play-copy{background:#ecece6;padding:64px 70px}
  .play-copy h2,.hours h2{font-size:clamp(42px,4vw,62px);font-weight:400;margin:0 0 26px}
  .play-copy p{font-size:16px;line-height:1.55;max-width:530px;margin-bottom:62px}
  dl{margin:0}dl div{display:grid;grid-template-columns:1fr auto;align-items:center;border-bottom:1px solid #cfd1cc;padding:26px 0;font-size:16px}
  dt,dd{margin:0}
  .hours{background:#ecece8;padding:68px 0 88px;text-align:center}
  .hours-inner{max-width:1000px}
  .hours h2{margin-bottom:34px}
  .hours p{font-size:14px;margin:12px 0}
  .hours .btn{margin-top:22px}
  @media(max-width:900px){
    .home-hero{height:56vw;min-height:260px}
    .intro{padding:48px 0 60px}.intro h1{font-size:clamp(30px,9vw,36px);max-width:100%;line-height:1.12;overflow-wrap:anywhere}
    .motto{font-size:13px;margin-left:0}
    .intro p{margin:34px 0;font-size:15px}.intro-actions{gap:14px;flex-wrap:wrap}.btn{min-width:150px}
    .play{grid-template-columns:1fr;padding-bottom:48px}.play>img{min-height:0;aspect-ratio:1/1}.play-copy{padding:38px 28px}
    .play-copy h2,.hours h2{font-size:34px}.play-copy p{margin-bottom:30px}.hours{padding:50px 0}
  }
</style>
</Layout>
