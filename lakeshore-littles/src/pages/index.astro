---
import Layout from '../layouts/Layout.astro';
const base=import.meta.env.BASE_URL;
---
<Layout><main><section class="hero"><div class="hero-copy"><div class="eyebrow">WHERE FAMILIES SIP &amp; PLAY</div><h1>Lakeshore Littles Play Café</h1><p>Come play, sip, and stay awhile at Lakeshore Littles Play Café—a modern, feel-good space made for laughter, connection, and everyday magic.</p><div class="hero-actions"><a class="button" href={base}>Explore Our Space</a><a class="button ghost" href={base+'menus/'}>Café Menu</a></div></div><img class="hero-image" src="https://static.wixstatic.com/media/1cc917_f3baa7fd5e7945fd9c31a317186aecc6~mv2.png" alt="Original visual displayed on the Lakeshore Littles Wix homepage" loading="eager"/></section><section class="section" id="play-space"><div class="wrap play"><img src="https://static.wixstatic.com/media/1cc917_6e3e0c8d65ec4f309aa19415aa08a50a~mv2.jpg" loading="lazy" alt="Play-space illustration shown on the existing Wix site"/><div><h2>Our Play Space</h2><p>We’ve created a space where connection just happens—where kids can play, explore, and laugh, and caregivers can slow down, recharge, and enjoy the moment right alongside them.</p><div class="prices"><div><span>Single Child Play</span><strong>$10.00</strong></div><div><span>Punch Cards</span><strong>$80.00</strong></div><div><span>Birthday Parties</span><strong>$300.00</strong></div></div></div></div></section><section class="section hours"><div class="wrap"><h2>Hours &amp; Location</h2><p>Open Play Hours: Monday–Friday: 9:00 AM – 2:00 PM<br/>Saturday–Sunday: Closed for events</p><p>Location: 1125 Washington Ave, Grand Haven, MI 49417</p><a class="button" href="https://maps.apple.com/?q=1125+Washington+Ave+Grand+Haven+MI+49417" rel="noopener noreferrer" target="_blank">Get Directions ↗</a></div></section></main><style>.hero{max-width:1240px;margin:0 auto;min-height:520px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:25px;padding:32px 28px 70px}.hero-copy{padding:28px}.eyebrow{font-size:15px;letter-spacing:.19em;margin-bottom:23px}.hero h1{font-size:clamp(42px,4.5vw,65px);font-weight:500;line-height:1.13;margin:0 0 24px}.hero p{font-size:17px;line-height:1.8;max-width:470px}.hero-actions{display:flex;flex-wrap:wrap;gap:13px;margin-top:28px}.ghost{background:transparent;color:#222;border:1px solid #222}.hero-image{width:100%;object-fit:contain}.play{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:60px}.play img{width:100%;object-fit:cover}.prices{margin-top:40px;display:grid;gap:22px}.prices div{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid #ddd;padding-bottom:13px;gap:20px}.prices strong{font-size:22px;font-weight:500}.hours{text-align:center;background:#fafafa}.hours h2{font-size:38px}.hours p{font-size:17px}@media(max-width:800px){.hero,.play{grid-template-columns:1fr}.hero{padding:30px 20px}.hero-copy{padding:10px}.hero-image{max-height:420px}.play{gap:35px}.hours h2{font-size:30px}}@media(max-width:390px){.hero h1{font-size:37px}.prices div{flex-wrap:wrap}}</style></Layout>