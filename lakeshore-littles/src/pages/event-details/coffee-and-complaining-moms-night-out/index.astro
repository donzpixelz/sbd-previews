---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Coffee and complaining - mom’s night out! | Lakeshore Littles Play Café">
<main class="event-detail page-width">
  <h1>Coffee and complaining - mom’s night out!</h1>
  <p class="meta">Fri, Sep 18 &nbsp; | &nbsp; 1125 Washington Ave</p>
  <p class="description">Join us to sip and complain! Your ticket includes a craft of your choice (jewelry dish or wine glass), a drink, and conversations with other moms who just get it! We will also have a permanent jewelry booth where you can purchase some jewelry!</p>
  <span class="ticket">Get tickets!!</span>
  <p class="not-sale">Tickets are not on sale</p>
  <hr/>
  <h2>Time &amp; Location</h2>
  <p>Sep 18, 2026, 7:00 PM</p>
  <p>1125 Washington Ave, 1125 Washington Ave, Grand Haven, MI 49417, USA</p>
  <h2>About the event</h2>
  <p>Join us! Secure your spot and let us know which craft you want -</p>
</main>
<style>
  .event-detail{max-width:900px;text-align:center;padding:86px 0 110px}.event-detail h1{font-size:54px;font-weight:400;margin:0 0 18px}.meta{color:#666}
  .description{font-size:17px;line-height:1.65;margin:48px auto 26px;max-width:760px}.ticket{display:inline-block;background:var(--blue);color:#fff;padding:15px 32px;border-radius:2px}
  .not-sale{font-size:13px;color:#777}.event-detail hr{border:0;border-top:1px solid #ddd;margin:70px 0}.event-detail h2{font-size:36px;font-weight:400;margin-top:42px}
</style>
</Layout>
